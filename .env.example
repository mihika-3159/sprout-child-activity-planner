# Sprout Child Activity Planner Environment Configuration

# Primary AI Provider — set to "cohere" or "gemini"
AI_PROVIDER=cohere
AI_MODEL=command-r
AI_ALLOW_PAID_USAGE=false

# Cohere API (free trial: 1,000 calls/month — https://dashboard.cohere.com/api-keys)
COHERE_API_KEY=your_cohere_api_key_here

# Google Gemini API (alternative — free tier at https://aistudio.google.com/)
GEMINI_API_KEY=

# Fallback AI Provider (used during local testing or if primary is unconfigured)
AI_FALLBACK_PROVIDER=mock

# Demo Mode — set to "true" to unlock all plans for free (no payment required)
DEMO_MODE=true

# Storage Configuration (Path to local JSON database store; in serverless/Vercel defaults to /tmp/app_store.json)
DATABASE_PATH=./data/app_store.json

# Anonymous Session Secret (32+ random characters for JWT cookie encryption)
SESSION_SECRET=replace_with_a_secure_random_32_character_secret_key


# Payment Configuration (Stripe Sandbox / Mock)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Product Pricing (null = Free during beta / unconfigured)
PRODUCT_PRICE_WEEKLY=
PRODUCT_PRICE_MONTHLY=
PRODUCT_PRICE_YEARLY=
PRODUCT_CURRENCY=GBP

# Rate Limiting (Configurable thresholds)
RATE_LIMIT_CHAT_MAX=12
RATE_LIMIT_CHAT_WINDOW_MINUTES=10
RATE_LIMIT_PREVIEW_MAX=3
RATE_LIMIT_PREVIEW_WINDOW_MINUTES=30
RATE_LIMIT_GENERATION_MAX=3
RATE_LIMIT_GENERATION_WINDOW_MINUTES=60
RATE_LIMIT_REGENERATION_MAX=15
RATE_LIMIT_REGENERATION_WINDOW_MINUTES=60
